# Database
DATABASE_URL=postgres://postgres:password@localhost:5432/biotwin
REDIS_URL=redis://localhost:6379

# Ports
CORE_RUNNER_PORT=3000
BIO_SYNTHS_PORT=8000

# API Keys
GEMINI_API_KEY=your_gemini_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
AI_LAYER_API_KEY=your_api_key_here

# Cloud IoT — ThingSpeak
# Create a free channel at https://thingspeak.com and paste the Write API Key here.
# Field mapping: field1=HR, field2=SpO2, field3=Temp, field4=Humidity, field5=Pressure, field6=Stress, field7=HealthScore
THINGSPEAK_API_KEY=your_thingspeak_write_api_key_here
